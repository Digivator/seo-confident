{
    "name": "digivator/seo-confident",
    "description": "A lightweight WordPress SEO plugin with meta tags, XML sitemaps, schema markup, robots.txt and llms.txt editors, redirects and breadcrumbs.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "homepage": "https://digivator.co.uk",
    "keywords": [
        "wordpress",
        "wordpress-plugin",
        "seo",
        "schema",
        "sitemap",
        "llms-txt"
    ],
    "authors": [
        {
            "name": "Digivator",
            "homepage": "https://digivator.co.uk"
        }
    ],
    "support": {
        "issues": "https://github.com/digivator/seo-confident/issues",
        "source": "https://github.com/digivator/seo-confident"
    },
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "phpcs": "phpcs",
        "phpcbf": "phpcbf"
    }
}
